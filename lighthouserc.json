{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4323",
      "startServerReadyPattern": "localhost:4323",
      "url": [
        "http://localhost:4323/es/cafes/hambela",
        "http://localhost:4323/en/coffee/hambela",
        "http://localhost:4323/es/cafes",
        "http://localhost:4323/es/checkout"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
