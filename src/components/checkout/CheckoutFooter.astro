---
/** Checkout Footer (Figma 27:6943): solo la línea legal. */
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<footer class="border-t border-border-subtle">
  <div class="mx-auto w-full max-w-[90rem] px-5 py-6 md:px-10 lg:px-20">
    <p class="type-body-xs text-text-tertiary">{t('footer/legal')}</p>
  </div>
</footer>
