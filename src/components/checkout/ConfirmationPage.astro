---
/** Página de pedido confirmado (la usan /es/pedido-confirmado y /en/order-confirmed). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { artFor } from '@/lib/art';
import { buildCartCatalog, getProducts } from '@/lib/catalog';
import { otherLocale, routePath, useTranslations, type Locale } from '@/i18n';
import ConfirmationApp from './ConfirmationApp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const products = await getProducts();
const catalog = buildCartCatalog(products, locale);
const art = Object.fromEntries(products.map((product) => [product.id, artFor(product, locale)]));
const subscriptionPct = products.find((product) => product.subscription)?.subscription?.discountPct ?? 10;
---

<BaseLayout
  locale={locale}
  title={t('confirm/eyebrow')}
  description={t('confirm/meta-description')}
  alternatePath={routePath(otherLocale(locale), { name: 'confirmation' })}
  catalog={catalog}
  noindex
>
  <ConfirmationApp client:load locale={locale} art={art} subscriptionPct={subscriptionPct} />
</BaseLayout>
