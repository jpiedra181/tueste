---
/**
 * Flavor Meter (Figma 24:7261): etiqueta, 5 segmentos y "4/5".
 * El valor también va en texto ("4/5" visible y "Acidez: 4 de 5" para lectores de pantalla):
 * no depende solo del color de los segmentos.
 */
interface Props {
  label: string;
  /** 1–5 */
  value: number;
  /** Texto accesible completo, p. ej. "Acidez: 4 de 5". */
  a11yLabel: string;
}

const { label, value, a11yLabel } = Astro.props;
const segments = [1, 2, 3, 4, 5];
---

<li class="flex items-center gap-4">
  <span class="sr-only">{a11yLabel}</span>
  <span class="w-[110px] shrink-0 type-label-m text-text-primary" aria-hidden="true">
    {label}
  </span>
  <span class="flex min-w-0 flex-1 gap-1" aria-hidden="true">
    {segments.map((n) => (
      <span
        class:list={['h-1.5 min-w-px flex-1 rounded-[3px]', n <= value ? 'bg-action-primary' : 'bg-bg-muted']}
      />
    ))}
  </span>
  <span class="shrink-0 type-mono-s text-text-tertiary" aria-hidden="true">
    {value}/5
  </span>
</li>
