---
/**
 * Icono del sistema. Decorativo por defecto (aria-hidden); con `label` se anuncia como imagen.
 * El color sale de `currentColor`: usa clases text-icon-* en el propio icono o en el padre.
 */
import { iconUrl, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  /** px. Figma: icon-sm 16, icon-md 20, icon-lg 24 (también se usa 18). */
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
---

<span
  class:list={['tueste-icon', className]}
  style={`--icon: url("${iconUrl(name)}"); --icon-size: ${size}px;`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}></span>
