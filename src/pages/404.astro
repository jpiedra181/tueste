---
/**
 * 404 (no está en Figma). Netlify sirve este único fichero para cualquier ruta inexistente, así que
 * va en español (idioma por defecto) con un bloque en inglés marcado con lang="en".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/layout/SectionHeader.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { buttonClasses } from '@/components/ui/button';
import { routePath, useTranslations, type Locale } from '@/i18n';
import { buildCartCatalog, getProducts } from '@/lib/catalog';

const locale: Locale = 'es';
const t = useTranslations(locale);
const en = useTranslations('en');
const products = await getProducts();
const catalog = buildCartCatalog(products, locale);
---

<BaseLayout
  locale={locale}
  title={t('notfound/title')}
  description={t('notfound/body')}
  alternatePath={routePath('en', { name: 'home' })}
  catalog={catalog}
  noindex
>
  <section class="container-page pt-12 pb-16 lg:pt-20 lg:pb-24">
    <SectionHeader level={1} eyebrow={t('notfound/eyebrow')} title={t('notfound/title')} lede={t('notfound/body')}>
      <a href={routePath(locale, { name: 'listing' })} class={buttonClasses({ variant: 'primary', size: 'lg' })}>
        {t('related/view-all')}
        <Icon name="arrow-right" size={20} />
      </a>
      <a href={routePath(locale, { name: 'home' })} class={buttonClasses({ variant: 'secondary', size: 'lg' })}>
        {t('nav/home')}
      </a>
    </SectionHeader>

    <div lang="en" class="mt-12 flex max-w-[41rem] flex-col items-start gap-2 border-t border-border-subtle pt-8 lg:mt-16">
      <p class="type-heading-h4 text-text-primary">{en('notfound/title')}</p>
      <p class="type-body-m text-text-secondary">{en('notfound/body')}</p>
      <a
        href={routePath('en', { name: 'listing' })}
        hreflang="en"
        class="mt-2 inline-flex min-h-6 items-center gap-2 rounded-xs type-label-m text-text-primary underline underline-offset-4 hover:text-text-accent"
      >
        {en('related/view-all')}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <section aria-labelledby="notfound-grid-title" class="bg-bg-subtle py-16 lg:py-30">
    <div class="container-page flex flex-col gap-8 lg:gap-10">
      <SectionHeader id="notfound-grid-title" eyebrow={t('listing/eyebrow')} title={t('home/grid-title')} />
      <ul role="list" class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-12 xl:grid-cols-4">
        {
          products.map((product) => (
            <li>
              <ProductCard product={product} locale={locale} headingLevel={3} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
